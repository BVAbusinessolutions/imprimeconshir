# ─── Firebase ─────────────────────────────────────────────────
# Obtén estos valores en: Firebase Console > Tu proyecto > Configuración del proyecto
VITE_FIREBASE_API_KEY=tu-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── WhatsApp (número de contacto de la tienda) ────────────────
VITE_WHATSAPP_NUMBER=521XXXXXXXXXX

# ─── URL base de API (si tienes backend propio) ───────────────
VITE_API_URL=http://localhost:3000/api

# ─── n8n (motor de automatización: chat IA, cotizaciones, citas) ─
# URL base de los webhooks de producción, sin barra final.
# Si se deja vacía, la web usa respuestas simuladas (modo de prueba).
VITE_N8N_WEBHOOK_URL=
# Forzar el modo de prueba aunque haya URL (true/false)
VITE_N8N_MOCK=false
